# Salin jadi env var di Koyeb (jangan commit token/kunci asli ke repo)
BRIDGE_TOKEN=ganti-dengan-token-acak-panjang

# AI instan di dalam web (opsional): kunci API Groq gratis dari
# console.groq.com. Bila terpasang, server membalas sendiri dalam
# hitungan detik memakai persona-ai-web.md. Bila kosong, Alive yang
# membalas lewat API token seperti sebelumnya.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
