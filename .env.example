# Salin jadi env var di Koyeb (jangan commit token/kunci asli ke repo)
BRIDGE_TOKEN=ganti-dengan-token-acak-panjang

# AI instan di dalam web (opsional, cukup SALAH SATU): bila terpasang,
# server membalas sendiri dalam hitungan detik memakai
# persona-ai-web.md. Bila keduanya kosong, Alive yang membalas lewat
# API token seperti sebelumnya.
# Pilihan owner: Gemini (gratis dari aistudio.google.com) — diutamakan
# bila terpasang.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Pilihan kedua: Groq (gratis dari console.groq.com).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
